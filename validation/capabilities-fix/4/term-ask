#!/usr/bin/env bash
# term-ask <case> <prompt> [timeout-s] [settle-s]
# Types a prompt into term-a (tmux -L term-a), approves each permission prompt once
# (saving its screen), waits until the turn has ended (no "esc to interrupt" for 8 s
# after it was seen), waits settle-s more (default 5) for anything that follows, then
# saves the scrollback and term-a's mod log lines written meanwhile.
# Evidence: validation/capabilities/acceptance/hazel/<case>/
set -u
c="$1"; prompt="$2"; timeout="${3:-600}"; settle="${4:-5}"
E=${TERM_ASK_BASE:-/srv/agents/hazel/agent-comms/validation/capabilities/acceptance/hazel}/$c
mkdir -p "$E"; rm -f "$E"/permission-prompt-*.txt
TM=(tmux -L term-a); T=term-a
log=$HOME/.local/state/agent-comms/mod/term-a.log
t0=$(date -u +%FT%T)
printf '%s\n' "$prompt" > "$E/prompt.txt"
{ echo "case: $c"; echo "started: $(date -u +%FT%TZ)"; } > "$E/run.txt"
"${TM[@]}" clear-history -t $T
"${TM[@]}" send-keys -t $T -l "$prompt"; sleep 1; "${TM[@]}" send-keys -t $T Enter
end=$(( $(date +%s) + timeout )); seen=0; quiet=0; n=0
while [ "$(date +%s)" -lt "$end" ]; do
  screen=$("${TM[@]}" capture-pane -p -t $T)
  if grep -q -E "Do you want to|❯ 1\. Yes" <<<"$screen"; then
    n=$((n+1)); printf '%s\n' "$screen" > "$E/permission-prompt-$n.txt"; "${TM[@]}" send-keys -t $T Enter; sleep 3; continue
  fi
  if grep -q "esc to interrupt" <<<"$screen"; then seen=1; quiet=0; else [ $seen = 1 ] && quiet=$((quiet+1)); fi
  [ $seen = 1 ] && [ $quiet -ge 8 ] && break
  sleep 1
done
echo "turn ended: $(date -u +%FT%TZ) (seen busy: $seen)" >> "$E/run.txt"
sleep "$settle"
awk -v t0="$t0" '$1 >= t0' "$log" > "$E/mod-log.txt"
"${TM[@]}" capture-pane -p -t $T -S -3000 > "$E/terminal.txt"
echo "ended: $(date -u +%FT%TZ)" >> "$E/run.txt"
